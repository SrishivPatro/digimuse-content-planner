{
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/bench.js": {
      "maxDuration": 300
    },
    "api/og.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
