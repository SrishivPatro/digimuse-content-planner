{
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/bench.js": {
      "maxDuration": 300
    },
    "api/og.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/image.js": {
      "maxDuration": 120
    },
    "api/log.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 3 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/img",
      "destination": "/api/image"
    },
    {
      "source": "/api/usage",
      "destination": "/api/log?usage=1"
    }
  ]
}